DISCORD_TOKEN=dein-bot-token-hier
# ID deines Discord-Servers (der Bot läuft nur dort)
GUILD_ID=
# Nur auf Railway: Pfad zum Volume
# DB_PATH=/data/clanbot.db

# Öffentliche Adresse der Website (z. B. https://deine-seite.up.railway.app) – nötig für /website und Discord-Login
# PUBLIC_URL=
# Discord-Login der Website (Developer Portal -> OAuth2): Redirect = PUBLIC_URL + /callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Optional: eigener Schlüssel für Website-Logins (langer Zufallstext)
# SESSION_SECRET=

# Impressum/Datenschutz (Pflicht für eine öffentliche Website in Deutschland). Nur hier/in Railway eintragen, nicht in den Code.
# Adresse mit | trennen, z. B.: Musterstraße 1 | 12345 Musterstadt
# IMPRESSUM_NAME=
# IMPRESSUM_ADDRESS=
# IMPRESSUM_EMAIL=
# IMPRESSUM_PHONE=

# Optional: Download-Link der Windows-App (wird im Befehl /website und im Footer gezeigt)
# APP_DOWNLOAD_URL=https://github.com/DEIN-NAME/DEIN-APP-REPO/releases/download/latest/Squizyys-App.exe
